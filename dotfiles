#!/bin/bash

# shellcheck source=/dev/null

BIN_NAME=$(basename "$0")
COMMAND_NAME=$1
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

SMU_HOME_DIR="${SMU_HOME_DIR:-$HOME/set-me-up}"

smu_cmd() {
  if [ -x "$SCRIPT_DIR/smu" ]; then
    "$SCRIPT_DIR/smu" "$@"
  elif command -v smu >/dev/null 2>&1; then
    command smu "$@"
  elif [ -x "$SMU_HOME_DIR/set-me-up-installer/smu" ]; then
    "$SMU_HOME_DIR/set-me-up-installer/smu" "$@"
  else
    echo "error: smu not found (install set-me-up or set SMU_HOME_DIR)" >&2
    return 127
  fi
}

require_smu_home() {
  if [ ! -d "$SMU_HOME_DIR" ]; then
    echo "error: set-me-up not found at $SMU_HOME_DIR" >&2
    echo "hint: install set-me-up or set SMU_HOME_DIR" >&2
    return 1
  fi
}

help() {
  echo "Usage: $BIN_NAME <command> [args]"
  echo
  echo "Commands:"
  echo "   clean            Clean package/tool caches when present (OS + language managers)"
  echo "   edit             Open set-me-up in \$EDITOR (falls back to \$VISUAL, then vi)"
  echo "   preferences      Apply the preferences module via smu"
  echo "   update [args]    Update via smu update (default: --all)"
  echo "   help             This help message"
}

edit() {
  require_smu_home || return 1

  # Unquoted so values like `code --wait` work.
  # shellcheck disable=SC2086
  ${EDITOR:-${VISUAL:-vi}} "$SMU_HOME_DIR"
}

update() {
  require_smu_home || return 1

  if [ "$#" -eq 0 ]; then
    smu_cmd update --all
  else
    smu_cmd update "$@"
  fi
}

# Run "$@" when $1 is on PATH. Prints a short label and continues on failure.
_clean_run() {
  local label=$1
  shift
  command -v "$1" >/dev/null 2>&1 || return 0
  echo "→ $label"
  "$@" || echo "warning: $label cleanup failed" >&2
}

clean() {
  _clean_run "Homebrew" brew cleanup

  if [ -n "${NVM_DIR:-}" ] && [ -s "$NVM_DIR/nvm.sh" ]; then
    echo "→ nvm"
    # shellcheck disable=SC1091
    . "$NVM_DIR/nvm.sh" && nvm cache clear ||
      echo "warning: nvm cleanup failed" >&2
  fi

  _clean_run "npm" npm cache clean --force
  _clean_run "yarn" yarn cache clean
  _clean_run "pnpm" pnpm store prune

  if command -v pip3 >/dev/null 2>&1; then
    _clean_run "pip3" pip3 cache purge
  else
    _clean_run "pip" pip cache purge
  fi

  _clean_run "Go" go clean -cache
  _clean_run "mise" mise cache clear
  _clean_run "RubyGems" gem cleanup
  _clean_run "Composer" composer clear-cache

  # System package caches need root; skip quietly for normal users.
  if [ "$(id -u)" -eq 0 ]; then
    _clean_run "apt" apt-get clean
    _clean_run "apt autoclean" apt-get autoclean
    _clean_run "pacman" pacman -Sc --noconfirm
  fi
}

preferences() {
  require_smu_home || return 1
  smu_cmd -p -m preferences --no-base
}

case "$COMMAND_NAME" in
"" | "-h" | "--help" | help)
  help
  ;;
*)
  shift
  if ! declare -f "$COMMAND_NAME" >/dev/null; then
    echo "'$COMMAND_NAME' is not a known command." >&2
    help
    exit 1
  fi
  "${COMMAND_NAME}" "$@"
  exit $?
  ;;
esac
